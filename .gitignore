# Rust
target/

# 前端
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
.cache/

# Tauri 生成物
src-tauri/gen/schemas/

# 系统
.DS_Store

# 打包用的 git 二进制，由 fab git-download 下载。
# 目录本身要留在仓库里（.gitkeep）：tauri.conf.json 把它声明成了打包资源，
# 路径不存在的话 tauri-build 的构建脚本直接失败——CI 上没人会去下 28MB 的 git，
# 却仍然要能 cargo check。
src-tauri/resources/git/*
!src-tauri/resources/git/.gitkeep
icon-source.png
.tmp/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# Local credentials and machine-specific environment overrides.
.env
.env.*
!.env.example
!.env.sample

# Local runtime output (upstream test fixtures remain versioned).
/*.log
/playwright-report/
/blob-report/


# Native E2E recordings and diagnostics.
test-results/
# Temporary executables left by interrupted Bun --compile builds.
.*.bun-build

/dist-release/

# Storybook static preview.
/storybook-static/

# 符号链接形式的 target 也不能进仓库：`target/` 只匹配目录，曾把自指链接提交进 main 并在 ff 合并时覆盖掉真实构建缓存
src-tauri/target
