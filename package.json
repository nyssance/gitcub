{
  "name": "gitcub",
  "productName": "GitCub",
  "version": "0.1.1",
  "description": "A fast, multilingual Git client for GitHub and GitLab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun check --no-script -p tsconfig.json && bun check --no-script -p tsconfig.tools.json && vite build",
    "icons": "bash scripts/build-icons.sh",
    "preview": "vite preview",
    "test:upstream": "cargo build --locked --manifest-path src-tauri/Cargo.toml --example conformance && bun scripts/prepare-e2e.ts && bun tests/conformance/run.ts",
    "test:live:github": "bun tests/macos/live-github.ts",
    "test:live:gitlab": "bun tests/macos/live-gitlab.ts",
    "bench": "bun scripts/benchmark.ts",
    "bench:app": "bun scripts/bench-app.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:publish": "bun run storybook:build && bun scripts/publish-storybook.ts",
    "storybook:build": "storybook build",
    "dev:tauri": "bun tauri dev --features hasgard-testing --config src-tauri/tauri.dev-instance.conf.json",
    "storybook:test": "bun run storybook:build && playwright test --config .storybook/playwright.config.ts"
  },
  "dependencies": {
    "@nyssance/shadcn": "^4.23.2",
    "@alwith/module-desktop-shell": "^0.5.7",
    "@alwith/module-store": "^0.5.0",
    "@base-ui/react": "^1.9.0",
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@github/alive-client": "^1.2.0",
    "@lezer/common": "^1.5.5",
    "@lezer/css": "^1.3.9",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.8.1",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.3",
    "@lezer/yaml": "^1.0.4",
    "@nyssance/atlas": "^0.1.10",
    "@primer/octicons-react": "^19.42.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@tauri-apps/api": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-opener": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-os": "^3.0.0-alpha.3",
    "@xterm/xterm": "^6.0.0",
    "buffer": "^6.0.3",
    "byline": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compare-versions": "^6.1.1",
    "date-fns": "^4.4.0",
    "deep-equal": "^2.2.3",
    "effect": "^4.1.1",
    "event-kit": "^2.5.3",
    "events": "^3.3.0",
    "focus-trap": "^8.2.4",
    "focus-trap-react": "^12.0.3",
    "fuzzaldrin-plus": "^0.6.0",
    "i18next": "^26.6.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.66.0",
    "mem": "^10.0.0",
    "memoize-one": "^6.0.0",
    "motion": "^14.9.0",
    "p-limit": "^7.3.3",
    "parse-dds": "^1.2.1",
    "path-browserify": "^1.0.1",
    "path-win32": "^1.0.1",
    "process": "^0.11.10",
    "quick-lru": "^7.3.0",
    "re2js": "^2.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-resizable-panels": "^4.16.0",
    "react-virtualized-auto-sizer": "^2.0.4",
    "readable-stream": "^4.8.0",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.7.0",
    "textarea-caret": "^3.1.0",
    "timers-browserify": "^2.0.12",
    "util": "^0.12.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@nyssance/ts7-lint": "^0.1.3",
    "@oxc-project/runtime": "^0.156.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^3.0.0-alpha.5",
    "@tauri-apps/plugin-dialog": "^3.0.0-alpha.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/byline": "^4.2.36",
    "@types/deep-equal": "^1.0.4",
    "@types/event-kit": "^2.4.4",
    "@types/fuzzaldrin-plus": "^0.6.5",
    "@types/lodash": "^4.17.27",
    "@types/parse-dds": "^1.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/readable-stream": "^4.0.25",
    "@types/semver": "^7.8.0",
    "@types/textarea-caret": "^3.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "diff": "^9.0.0",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.1.3",
    "oxc-transform": "^0.155.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vscode-uri": "^3.2.0"
  }
}
