{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "rootDirs": ["tests/conformance/upstream/src", "src"]
  },
  "include": [
    "src/**/*.d.ts",
    "scripts/**/*.ts",
    "__mocks__/**/*.ts",
    "vite.config.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.tsx"
  ],
  "exclude": ["tests/conformance/upstream", "tests/conformance/fixtures"]
}
